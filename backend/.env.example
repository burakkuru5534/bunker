# Sığınak backend — yerel ortam değişkenleri örneği.
# Kopyalayın: cp .env.example .env  (.env git'e girmez)
# Gizli değerleri asla bu dosyaya yazmayın; bu dosya yalnızca anahtar adlarını gösterir.

# local | test | prod
APP_ENV=local

# Dinlenecek port (Cloud Run kendisi verir)
PORT=8080

# SIGTERM sonrası açık istekler için bekleme (Cloud Run ~10 sn verir)
SHUTDOWN_TIMEOUT=8s

# Desteklenen en eski mobil uygulama sürümü
MIN_APP_VERSION=0.1.0

# REST istek süre sınırı
REQUEST_TIMEOUT=10s

# Log seviyesi: debug | info | warn | error
LOG_LEVEL=info

# Google Cloud proje kimliği (gizli değil); doluysa loglar Cloud Trace'e bağlanır. Yerelde boş bırakın.
GCP_PROJECT_ID=

# Veritabanı bağlantısı (GİZLİ — gerçek değeri yalnızca .env'e yazın, kimseyle paylaşmayın).
# Biçim (Supabase panelinde Connect > Session pooler):
#   postgres://bunker_test_app.<proje-ref>:<şifre>@<pooler-host>:5432/postgres?sslmode=verify-full&sslrootcert=<sertifika yolu>
# Yerelde boş bırakılırsa servis veritabanısız başlar.
DATABASE_URL=

# Havuz üst sınırı (varsayılan: prod 5, diğer 3)
# DB_MAX_CONNS=3

# Havuzdan bağlantı için en uzun bekleme (varsayılan 3s)
# DB_ACQUIRE_TIMEOUT=3s

# Beklenen şema (varsayılan: prod bunker_prod, diğer bunker_test)
# DB_SCHEMA=bunker_test
